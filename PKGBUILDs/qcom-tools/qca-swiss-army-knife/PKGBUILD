pkgname=qca-swiss-army-knife
pkgver=0_git20220701
pkgrel=1
pkgdesc="Utilities to help and debug Qualcomm Atheros wireless driver development"
arch=('any')
url="https://github.com/qca/qca-swiss-army-knife"
license=('ISC')
depends=('python')

_commit="1b102ba5126bbbdae0efa6f568ac2467392b49f4"

source=("${pkgname}-${_commit}.tar.gz::${url}/archive/${_commit}.tar.gz")

sha512sums=(
    'e41d678f208cf09f02e78ebf4e1295837a43c2fd031d9f3b2be962772a7cdf2e2296f9751855847707ae5348b3da46f37f9c0aa858f7b7912cfd56e534f28f2f'
)

package() {
    cd "$srcdir/${pkgname}-${_commit}"
    
    mkdir -p "$pkgdir/usr/bin"
    find tools/scripts -type f -exec install -Dm755 {} -t "$pkgdir/usr/bin" \;
}
